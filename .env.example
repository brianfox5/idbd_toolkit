# Optional, for running the workspace on your own machine (local mode).
# Copy to .env (never committed). In local mode these keys serve as defaults for
# "Draft with agent"; you can also enter a key in the browser under ⚙ Agent.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# For an OpenAI-compatible endpoint that needs a key (OpenRouter, Mistral, …):
OPENAI_COMPATIBLE_API_KEY=
