# Server settings for the IDBD web workspace — copy to /etc/idbd/idbd.env
# (readable only by root and the idbd user: sudo chmod 640, chown root:idbd).

# Accounts, per-user workspaces, read-only demo for visitors.
IDBD_MODE=server
# Users, the cookie-signing key, and every workspace live here. Back it up.
IDBD_DATA_DIR=/var/lib/idbd
# The worked example shown to visitors (from the repository checkout).
IDBD_EXAMPLE_DIR=/opt/idbd/examples/data

# The URL prefix the site serves the app under (must match the web server config).
IDBD_ROOT_PATH=/idbd
# Listen only on the machine itself; the web server forwards to it.
IDBD_HOST=127.0.0.1
IDBD_PORT=8765

# Optional limits (defaults shown).
#IDBD_MAX_PROJECTS=50
#IDBD_QUOTA_MB=1000

# Agent keys: by default users bring their own keys and the server never holds
# one. Set to 1 only if you want keys in this file to serve as a fallback
# (they would be spent by every logged-in user).
#IDBD_SERVER_KEYS=0
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=
